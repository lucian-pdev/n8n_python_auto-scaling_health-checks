# ============================================
# N8N Configuration - PRODUCTION
# ============================================
N8N_HOST=n8n.replace_me.com                                    # n8n.yourdomain.com
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=True

# Security
N8N_BASIC_AUTH_USER=replace_me                                 # replace
N8N_BASIC_AUTH_PASSWORD='replace_me'                           # replace
N8N_ENCRYPTION_KEY="replace_me"                                # replace

# Port Bindings (localhost only - behind nginx)
N8N_PUBLISHED_PORT=127.0.0.1:5678:5678
GRAFANA_PUBLISHED_PORT=127.0.0.1:3000:3000
PROMETHEUS_PUBLISHED_PORT=127.0.0.1:9090:9090
CADVISOR_PUBLISHED_PORT=127.0.0.1:8080:8080
NODE_EXPORTER_PUBLISHED_PORT=127.0.0.1:9100:9100
PYTHON_API_PUBLISHED_PORT=127.0.0.1:8000:8000

# Grafana
GF_SECURITY_ADMIN_USER=replace_me                       # replace
GF_SECURITY_ADMIN_PASSWORD="replace_me"                 # replace

# Databases
REDIS_PASSWORD=replace_me                                      # replace
POSTGRES_USERNAME=replace_me                                   # replace
POSTGRES_PASSWORD='replace_me'                                  # replace

# Suppress deprecation warnings
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000
N8N_WEBHOOK_URL=https://n8n.replace_me.replace_me.replace_me       # replace
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000
N8N_PUSH_BACKEND=websocket

# Execution log variables
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=504                                 # 21 days instead of 14
EXECUTIONS_DATA_PRUNE_MAX_COUNT=20000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=20                          # store only 20 succesful runs for reference
EXECUTIONS_DATA_SAVE_ON_ERROR=all                           # keep failures for debugging
