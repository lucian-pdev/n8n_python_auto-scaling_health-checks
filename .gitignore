# macOS
.DS_Store

# Python (python-api/, workflows/)
__pycache__/
*.py[cod]
.venv/
venv/

# secrets and generated env files (the tracked template is "env", without the dot)
.env
.env.*

# Cursor editor
.cursorignore
.cursorindexingignore

# generated at deploy time
prometheus/conf.d/*.yml
*.log

# private notes (workflows/sheets_to_airtable/not-commited/)
not-commited/

# private publish notes: kept untracked in dev checkouts, never in main or hostinger
PUBLISH_REMINDER.md

# db/: proprietary NB migrations on the Hostinger server (they belong to the hostinger branch's db/, never tracked)
/db/
