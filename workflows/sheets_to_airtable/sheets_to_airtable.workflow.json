              "id": "f521f3e1-0eb3-47d0-a5e4-b95a6c22dac4",
              "leftValue": "={{ ($json.result?.result?.upserts ?? []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
