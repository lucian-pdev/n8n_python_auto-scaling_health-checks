            {
              "id": "b03285d8-7548-485a-bae3-d1bb3b27bf23",
              "name": "key_fields",
              "value": "[\"Email\"]",
              "type": "array"
            },
            {
              "id": "e14af92b-1cbb-40ea-8d0c-f755d9b69c4e",
              "name": "mapping",
              "value": "{\"Full name\": \"Name\", \"Email\": \"Email\", \"Stage\": \"Stage\"}",
              "type": "object"
            },
            {
              "id": "5b6c53b9-2a31-4f89-9d99-dd960d018079",
              "name": "attachments",
              "value": "{\"Photo\": \"Photo\"}",
              "type": "object"
            },
            {
              "id": "ba2f46e1-0b4a-4d84-8b47-cce9e973c968",
              "name": "rules",
              "value": "[{\"when\": {\"column\": \"Stage\", \"op\": \"equals\", \"value\": \"Hired\"}, \"set\": {\"Status\": \"Onboarding\"}}, {\"when\": {\"column\": \"Stage\", \"op\": \"equals\", \"value\": \"Archived\", \"source\": \"airtable\"}, \"skip\": true}]",
              "type": "array"
            },
