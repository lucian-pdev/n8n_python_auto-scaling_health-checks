        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ code_file_name: $('Config').first().json.script, data: { mode: 'plan', config: $('Config').first().json, rows: $('Read Sheet').all().map(i => i.json), records: $('Fetch Airtable').all().map(i => i.json) } }) }}"
      },
      "executeOnce": true
