    {
      "id": "8f7a5c3e-4827-4cbd-91a8-16df261243ba",
      "name": "Download from Drive",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        2640,
        100
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "value": "={{ $json.drive_file_id }}",
          "mode": "id"
        },
        "options": {}
      }
    },
    {
      "id": "5aba2bb5-e073-4f94-9c67-c1cd88aadb3f",
      "name": "Build Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        100
      ],
      "parameters": {
        "jsCode": "// Turn each downloaded Drive file into an Airtable uploadAttachment body.\n// getBinaryDataBuffer works whatever binary mode n8n runs in (memory / filesystem / S3).\nconst MAX = 5 * 1024 * 1024;            // Airtable uploadAttachment limit\nconst items = $input.all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  const job = $('Split Attachments').itemMatching(i).json;\n  const bin = items[i].binary?.data;\n  if (!bin) {\n    out.push({ json: { ...job, skip: `Drive download failed: ${items[i].json.error?.message ?? 'no file returned'}` } });\n    continue;\n  }\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  if (buf.length > MAX) {\n    out.push({ json: { ...job, skip: `file too large (${(buf.length / 1048576).toFixed(1)} MB, limit 5 MB)` } });\n    continue;\n  }\n  out.push({ json: {\n    ...job,\n    contentType: bin.mimeType || 'application/octet-stream',\n    filename: job.filename_prefix + (bin.fileName || 'file'),\n    file: buf.toString('base64'),\n  } });\n}\nreturn out;\n"
      }
    },
