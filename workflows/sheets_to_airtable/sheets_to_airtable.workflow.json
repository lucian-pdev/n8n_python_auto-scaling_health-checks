    {
      "id": "48e3c08a-9c0d-4feb-a9e9-e1e9b0ab3270",
      "name": "Plan Attachments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.python_api_url }}",
        "options": {
          "timeout": 120000
