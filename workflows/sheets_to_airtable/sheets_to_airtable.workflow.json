        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ code_file_name: $('Config').first().json.script, data: { mode: 'attachments', config: $('Config').first().json, rows: $('Read Sheet').all().map(i => i.json), records: $('Fetch Airtable').all().map(i => i.json).concat(($('Upsert Airtable').isExecuted ? $('Upsert Airtable').all().map(i => i.json) : [])) } }) }}"
