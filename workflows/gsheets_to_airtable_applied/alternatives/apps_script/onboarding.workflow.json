    {
      "id": "5aba2bb5-e073-4f94-9c67-c1cd88aadb3f",
      "name": "Build Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        100
      ],
      "parameters": {
        "jsCode": "// Turn each read-proxy file answer ({filename, contentType, size, base64}) into an uploadAttachment body.\n// Over max_upload_mb: images go to Shrink Image (if shrink_images), anything else is skipped.\nconst cfg = $('Config').first().json;\nconst MAX = (cfg.max_upload_mb || 5) * 1000 * 1000;      // Airtable uploadAttachment limit: 5 MB\nconst jobs = $('Split Attachments').all();\nreturn $input.all().map((item, i) => {\n  let job = {};\n  try {\n    try { job = $('Split Attachments').itemMatching(i).json; } catch (e) { job = jobs[i]?.json ?? {}; }\n    const f = item.json;\n    if (!f.base64) return { json: { ...job, skip: `file read failed: ${f.error?.message ?? f.error ?? 'no file returned'}` } };\n    const body = { ...job, contentType: f.contentType || 'application/octet-stream', file: f.base64,\n                   filename: job.filename_prefix + (f.filename || 'file'), size: f.size, max_bytes: MAX };\n    if (f.size <= MAX) return { json: body };\n    const mb = (f.size / 1e6).toFixed(1);\n    if (cfg.shrink_images && body.contentType.startsWith('image/')) return { json: { ...body, too_big: true } };\n    return { json: { ...job, skip: `file too large (${mb} MB, limit ${MAX / 1e6} MB${cfg.shrink_images ? ', not an image' : ', shrink_images off'})` } };\n  } catch (e) {                               // attachments are optional: never fail the run here\n    return { json: { ...job, skip: `Build Upload error: ${e.message}` } };\n  }\n});"
      },
      "onError": "continueRegularOutput"
    },
