    {
      "id": "5aba2bb5-e073-4f94-9c67-c1cd88aadb3f",
      "name": "Build Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        100
      ],
      "parameters": {
        "jsCode": "// Turn each downloaded Drive file (binary \"data\") into an uploadAttachment body.\n// Over max_upload_mb: images go to Shrink Image (if shrink_images), anything else is skipped.\n// getBinaryDataBuffer works whatever binary mode n8n runs in (memory / filesystem / S3).\nconst cfg = $('Config').first().json;\nconst MAX = (cfg.max_upload_mb || 5) * 1000 * 1000;      // Airtable uploadAttachment limit: 5 MB\nconst items = $input.all();\nconst jobs = $('Split Attachments').all();\nconst out = [];\nfor (let i = 0; i < items.length; i++) {\n  let job = {};\n  try {\n    try { job = $('Split Attachments').itemMatching(i).json; } catch (e) { job = jobs[i]?.json ?? {}; }\n    const bin = items[i].binary?.data;\n    if (!bin) {\n      out.push({ json: { ...job, skip: `Drive download failed: ${items[i].json.error?.message ?? 'no file returned'}` } });\n      continue;\n    }\n    const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n    const body = { ...job, contentType: bin.mimeType || 'application/octet-stream', file: buf.toString('base64'),\n                   filename: job.filename_prefix + (bin.fileName || 'file'), size: buf.length, max_bytes: MAX };\n    if (buf.length <= MAX) { out.push({ json: body }); continue; }\n    const mb = (buf.length / 1e6).toFixed(1);\n    if (cfg.shrink_images && body.contentType.startsWith('image/')) { out.push({ json: { ...body, too_big: true } }); continue; }\n    out.push({ json: { ...job, skip: `file too large (${mb} MB, limit ${MAX / 1e6} MB${cfg.shrink_images ? ', not an image' : ', shrink_images off'})` } });\n  } catch (e) {                               // attachments are optional: never fail the run here\n    out.push({ json: { ...job, skip: `Build Upload error: ${e.message}` } });\n  }\n}\nreturn out;"
      },
      "onError": "continueRegularOutput"
    },
