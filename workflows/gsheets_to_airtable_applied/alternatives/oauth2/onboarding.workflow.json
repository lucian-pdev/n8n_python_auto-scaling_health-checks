    {
      "id": "d89b8448-3891-46ca-ac2f-9c9ac6a11cc5",
      "name": "Apply Shrink",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        -120
      ],
      "parameters": {
        "jsCode": "// Swap in the shrunk JPEG; a failed shrink becomes a skip (see Skipped Attachments).\nconst jobs = $('Too Big?').all();\nreturn $input.all().map((item, i) => {\n  let job = {};\n  try { job = $('Too Big?').itemMatching(i).json; } catch (e) { job = jobs[i]?.json ?? {}; }\n  const res = item.json?.result ?? {};\n  if (res.status !== 'success') {\n    const { file, ...rest } = job;\n    return { json: { ...rest, skip: `shrink failed: ${res.error ?? item.json.error?.message ?? 'no response'}` } };\n  }\n  try {\n    const r = res.result;\n    return { json: { ...job, too_big: false, file: r.base64, contentType: r.contentType, size: r.size,\n                     filename: job.filename.replace(/\\.[^.]+$/, '') + '.jpg', shrunk_from: r.original_size } };\n  } catch (e) {\n    const { file, ...rest } = job;\n    return { json: { ...rest, skip: `Apply Shrink error: ${e.message}` } };\n  }\n});"
      },
      "onError": "continueRegularOutput"
    },
