# ============================================
# N8N Configuration - TESTING (template)
# ============================================
# Test counterpart of ../env (live). Same keys, test values; keep them in sync.
# Use: ./deploy.sh testing_files/env   (or ./env-maker.sh testing_files/env)
# DOMAIN left as a tag: random *.localhost, Traefik serves its self-signed cert
DOMAIN='replace_domain'
EMAIL='replace_email'
N8N_PROTOCOL=https
# n8n image version (main + workers). Pinned: an update is a deliberate .env change (see upgrade/README.md)
N8N_VERSION=2.43.3
# Docker network Traefik routes on (exact name, shared by Traefik, n8n-main, grafana)
TRAEFIK_NETWORK=naypyers-proxy
N8N_SECURE_COOKIE=True

# Traefik
ACME_CA_SERVER='https://acme-staging-v02.api.letsencrypt.org/directory'
TRAEFIK_LOG_LEVEL=DEBUG
TRAEFIK_DASHBOARD_PUBLISHED_PORT=8082:8080

# Security
N8N_BASIC_AUTH_USER='replace_user'
N8N_BASIC_AUTH_PASSWORD='replace_password'
N8N_ENCRYPTION_KEY='replace_ssl'
N8N_USER_MANAGEMENT_JWT_SECRET='replace_ssl'

# Port Bindings (all interfaces - reachable from the VM host)
N8N_PUBLISHED_PORT=5678:5678
GRAFANA_PUBLISHED_PORT=3000:3000
PROMETHEUS_PUBLISHED_PORT=9090:9090
CADVISOR_PUBLISHED_PORT=8080:8080
NODE_EXPORTER_PUBLISHED_PORT=9100:9100
PYTHON_API_PUBLISHED_PORT=8000:8000

# Grafana
GF_SECURITY_ADMIN_USER='replace_user'
GF_SECURITY_ADMIN_PASSWORD='replace_password'

# Databases
REDIS_PASSWORD='replace_password'
POSTGRES_USERNAME='replace_user'
POSTGRES_PASSWORD='replace_password'

# Scripts sync (github_sync systemd timer)
# Any HTTP(S) git host works (GitHub, Gitea/Forgejo, GitLab). To test against another
# repo, override SCRIPTS_REPO / GITHUB_TOKEN in .env, not here (see Testing Documentation.md).
SCRIPTS_REPO='https://github.com/lucian-pdev/n8n_python_auto-scaling_health-checks.git'
SCRIPTS_BRANCH='scripts'
GITHUB_TOKEN=''
SYNC_INTERVAL_MINUTES=1

# Autoscaler (n8n-worker replicas) - sized for a small test VM
AUTOSCALE_MIN_REPLICAS=1
AUTOSCALE_MAX_REPLICAS=3
AUTOSCALE_THRESHOLD_UP=4
AUTOSCALE_COOLDOWN=60

# Suppress deprecation warnings
N8N_UNVERIFIED_PACKAGES_ENABLED=true
N8N_RUNNERS_TASK_TIMEOUT=300
N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648
N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000
N8N_PUSH_BACKEND=websocket
